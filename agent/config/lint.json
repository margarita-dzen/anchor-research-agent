    "pattern": "дерматолог|dermatolog",
    "level": "warn",
    "why": "без измислени лекари/дерматолози; провери дали е истински експерт"
   },
   {
    "id": "bgn_on_ro",
    "pattern": "\\bлв\\.?|\\bBGN\\b",
    "level": "error",
    "why": "на RO пазара цени само в евро/леи, без лева",
    "lang": "ro"
   }
  ]
 },
