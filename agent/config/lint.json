{
 "_doc": "Забранени думи и изрази в текста на страниците по клиент (lint_copy.py). pattern е regex без значение от главни/малки букви. level: error = спира „готово“, warn = провери на ръка. Проверяват се видимият текст, alt и title на снимките.",
 "common": [
  {
   "id": "em_dash",
   "pattern": "—",
   "level": "error",
   "why": "без тирета (em dash) никъде"
  },
  {
   "id": "en_dash_as_dash",
   "pattern": "(?<!Lavanda Dream)\\s–\\s",
   "level": "error",
   "why": "en dash с интервали = тире в изречение (изключение: името „Lavanda Dream – …“, решение на Валентин 22.10)"
  },
  {
   "id": "hyphen_as_dash",
   "pattern": "(?<=[^\\W\\d_])\\s-\\s(?=[^\\W\\d_])",
   "level": "warn",
   "why": "дефис с интервали, вероятно тире в изречение"
  },
  {
   "id": "illustrative",
   "pattern": "илюстратив|ilustrativ|illustrativ|illustrative",
   "level": "error",
   "why": "никога „илюстративна снимка“ (нито надпис, нито alt)"
  },
  {
   "id": "illustration",
   "pattern": "\\bИлюстрация\\b|\\bIlustrație\\b|\\bIlustratie\\b",
   "level": "error",
   "why": "никога „Илюстрация“"
  },
  {
   "id": "ad_label",
   "pattern": "Рекламна публикация|\\bPublicitate\\b|Reklame|Anzeige\\b|Advertorial",
   "level": "error",
   "why": "етикетите „Рекламна публикация“ се махат винаги"
  },
  {
   "id": "fig_label",
   "pattern": "\\bFIG\\.?\\s*\\d|\\bФИГ\\.?\\s*\\d",
   "level": "error",
   "why": "никъде „FIG.“ пред номерата на снимките/секциите, само числото (Валентин 23.10)"
  },
  {
   "id": "composite_label",
   "pattern": "събирателен образ|събирателна история|imagine compozit|personaj compozit",
   "level": "error",
   "why": "никъде „събирателен образ“ (Валентин 23.10, разказвачките)"
  }
 ],
 "so_simple": {
  "_doc": "So Simple (Carina Precious): козметика, без медицински твърдения; без „100% натурални“ (greenwashing 14.10); гаранции и оферти само с ОК от Елица.",
